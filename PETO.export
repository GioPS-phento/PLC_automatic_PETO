            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PREPARACION
VAR
	RE: BOOL;
	aux1: BOOL;
	CCurrent_State: INT := 10;
	P2: BOOL;
	M1: BOOL;
	// Calentadaor
	K1: BOOL;
	// motor principal
	MO: BOOL;
	TIMERPETO: TON;
	// el tiempo de espera se cumplio
	Tim1: BOOL;
	// error de calentador
	ErrC: BOOL;
	// temperatura tanque
	H1: INT;
	// MANTENIMIENTO
	Mt: BOOL;
	// error de motor
	ErrM: BOOL;
	TIMERMOTOR: TON;
	// peto listo
	Ro: BOOL;
END_VAR
</Single>
