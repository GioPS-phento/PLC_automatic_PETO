	aux4: BOOL;
	TIMER_PANELA: TON;
	aux5: BOOL;
	// puerta panela
	Ppa: BOOL;
	aux6: BOOL;
	aux7: BOOL;
	aux8: BOOL;
	TON_Final: TON;
	// Terminado
